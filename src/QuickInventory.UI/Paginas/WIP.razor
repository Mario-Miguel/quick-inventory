@page "/sales"
@page "/incomes"
@page "/payments"
@inject NavigationManager Navigation

@* Marcador temporal para los módulos que aún no están hechos. *@

<h1 class="page-title">@Titulo</h1>

<MudPaper Class="pa-8 d-flex flex-column align-center gap-4" Elevation="0" Outlined="true">
    <MudIcon Icon="@Icons.Material.Filled.Construction" Style="font-size:4rem" Color="Color.Secondary" />
    <MudText Typo="Typo.h6">Esta parte todavía está en construcción.</MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">Volver al inicio</MudButton>
</MudPaper>

@code {
    private string Titulo => Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/') switch
    {
        "sales" => "Ventas",
        "incomes" => "Ingresos",
        "payments" => "Pagos",
        _ => ""
    };
}
