@page "/"
@inject ActiveProfile Profile
@implements IDisposable

<h1 class="page-title">¿Qué quieres hacer?</h1>

<MudGrid Spacing="4">
    @foreach (var module in Modules.For(Profile.Current))
    {
        <MudItem xs="12" md="6">
            <MudButton Href="@module.Route"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="button-module">
                <div class="d-flex align-center gap-6" style="width:100%">
                    <MudIcon Icon="@module.Icon" Class="icon-module" />
                    <div class="text-left">
                        <div class="title-module">@module.Title</div>
                        <div class="description-module">@module.Description</div>
                    </div>
                </div>
            </MudButton>
        </MudItem>
    }
</MudGrid>

@code {
    // Al cambiar de perfil cambian las opciones que se muestran.
    protected override void OnInitialized() => Profile.Changed += OnProfileChanged;

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Profile.Changed -= OnProfileChanged;
}
