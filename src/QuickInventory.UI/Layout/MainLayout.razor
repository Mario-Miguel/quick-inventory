@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject ActiveProfile Profile
@inject IConnectionStatus Connection
@inject IIssuerService IssuerService
@inject ClientSettings Client
@inject IAppUpdater Updater
@inject IDialogService Dialogs
@inject ISnackbar Warnings

<MudThemeProvider Theme="theme" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" BackdropClick="false" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        @if (!InHomepage)
        {
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Color="Color.Inherit"
                           Size="Size.Large"
                           Href="/"
                           aria-label="Volver al inicio" />
        }
        <MudText Typo="Typo.h6" Class="ml-2">@Client.AppName</MudText>
        <MudSpacer />
        @if (newVersion is not null)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.SystemUpdateAlt"
                       Disabled="updating"
                       OnClick="Update"
                       Class="mr-4">
                @(updating ? $"Actualizando… {downloaded} %" : $"Actualizar a la versión {newVersion}")
            </MudButton>
        }
        @* Cambio de perfil: sin contraseña, basta con elegir el otro. *@
        <MudMenu Disabled="@(setup != SetupState.Done)" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="mr-4">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Inherit"
                           Size="Size.Large"
                           StartIcon="@ActiveProfile.Icon(Profile.Current)"
                           EndIcon="@Icons.Material.Filled.ArrowDropDown"
                           OnClick="context.ToggleAsync">
                    @ActiveProfile.Name(Profile.Current)
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                @foreach (var salesPoint in Enum.GetValues<SalesPoint>())
                {
                    <MudMenuItem Icon="@ActiveProfile.Icon(salesPoint)"
                                 Disabled="@(salesPoint == Profile.Current)"
                                 OnClick="() => Profile.Change(salesPoint)">
                        Cambiar a @ActiveProfile.Name(salesPoint)
                    </MudMenuItem>
                }
            </ChildContent>
        </MudMenu>
        <MudText Typo="Typo.body1" Class="header-date">@DateTime.Today.ToString("dddd, d 'de' MMMM 'de' yyyy")</MudText>
    </MudAppBar>

    <MudMainContent Class="pt-16">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @switch (setup)
            {
                case SetupState.Unknown:
                    <MudProgressCircular Indeterminate="true" />
                    break;
                case SetupState.Pending:
                    <FirstRunWizard OnFinished="SetupFinished" />
                    break;
                default:
                    @Body
                    break;
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@* Sin conexión con la base de datos no se puede trabajar: se tapa todo hasta que vuelva. *@
<MudOverlay Visible="@(!Connection.Connected)" DarkBackground="true" ZIndex="2000">
    <MudPaper Class="pa-8 connection-lost" Elevation="4">
        <MudIcon Icon="@Icons.Material.Filled.CloudOff" Color="Color.Error" Class="connection-lost-icon" />
        <MudText Typo="Typo.h5" Class="mt-2 mb-4">Sin conexión con el servidor</MudText>
        <MudText Typo="Typo.body1" Class="mb-2">No se pueden hacer ventas ni cambios.</MudText>
        <MudText Typo="Typo.body1" Class="mb-6">
            Si estabas cobrando, la venta <b>no</b> se ha registrado: no entregues el ticket.
            La aplicación se desbloqueará sola cuando vuelva la conexión.
        </MudText>
        <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh" Disabled="retrying" OnClick="Retry">
            Reintentar
        </MudButton>
    </MudPaper>
</MudOverlay>

@code {
    private enum SetupState { Unknown, Pending, Done }

    private SetupState setup;
    private bool retrying;
    private MudTheme theme = null!;
    private string? newVersion;
    private bool updating;
    private int downloaded;
    private readonly CancellationTokenSource stop = new();

    /// <summary>Cada cuánto se mira si hay versión nueva (los equipos suelen quedarse abiertos todo el día).</summary>
    private static readonly TimeSpan UpdateCheckInterval = TimeSpan.FromHours(2);

    private bool InHomepage => Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').Length == 0;

    protected override async Task OnInitializedAsync()
    {
        theme = Theme.For(Client.Colors);
        Navigation.LocationChanged += OnNavigation;
        Profile.Changed += OnProfileChanged;
        Connection.Changed += OnConnectionChanged;
        await CheckSetup();
        _ = CheckUpdatesAsync();
    }

    private async Task CheckUpdatesAsync()
    {
        if (!Updater.IsAvailable) return;
        using var timer = new PeriodicTimer(UpdateCheckInterval);
        try
        {
            do
            {
                try
                {
                    newVersion = await Updater.CheckAsync();
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    // Sin internet o sin servidor de actualizaciones: se vuelve a mirar en la próxima vuelta.
                }
            }
            while (await timer.WaitForNextTickAsync(stop.Token));
        }
        catch (OperationCanceledException)
        {
            // Se ha cerrado la ventana.
        }
    }

    private async Task Update()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Actualizar la aplicación",
            $"Se instalará la versión {newVersion}. La aplicación se cerrará y se volverá a abrir sola en unos minutos. " +
            "Si estás cobrando, termina antes la venta.",
            yesText: "Actualizar",
            cancelText: "Ahora no");
        if (confirmed != true) return;

        updating = true;
        try
        {
            await Updater.UpdateAndRestartAsync(p => InvokeAsync(() =>
            {
                downloaded = p;
                StateHasChanged();
            }));
        }
        catch (Exception)
        {
            Warnings.Add("No se ha podido descargar la actualización. Inténtalo más tarde.", Severity.Error);
            updating = false;
        }
    }

    /// <summary>Sin datos del titular hay que pasar antes por el asistente de la primera instalación.</summary>
    private async Task CheckSetup()
    {
        try
        {
            setup = await IssuerService.GetIssuerAsync() is null ? SetupState.Pending : SetupState.Done;
        }
        catch (Exception)
        {
            // Sin conexión: se vuelve a mirar cuando vuelva (OnConnectionChanged).
            setup = SetupState.Unknown;
        }
    }

    private void SetupFinished()
    {
        setup = SetupState.Done;
        Navigation.NavigateTo("/");
    }

    private void OnConnectionChanged() => InvokeAsync(async () =>
    {
        if (Connection.Connected && setup == SetupState.Unknown) await CheckSetup();
        StateHasChanged();
    });

    private async Task Retry()
    {
        retrying = true;
        await Connection.CheckAsync();
        retrying = false;
    }

    private void OnNavigation(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    // Si el nuevo perfil no puede estar en la pantalla actual, se vuelve al inicio.
    private void OnProfileChanged() => InvokeAsync(() =>
    {
        if (!Modules.Allows(Profile.Current, Client.Features, Navigation.ToBaseRelativePath(Navigation.Uri)))
            Navigation.NavigateTo("/");
        StateHasChanged();
    });

    public void Dispose()
    {
        Navigation.LocationChanged -= OnNavigation;
        Profile.Changed -= OnProfileChanged;
        Connection.Changed -= OnConnectionChanged;
        stop.Cancel();
    }
}
