<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">¿Confirmar la venta?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Large" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Size="Size.Large"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Confirm">
            Confirmar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private void Confirm()
    {
        Dialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => Dialog.Cancel();
}
