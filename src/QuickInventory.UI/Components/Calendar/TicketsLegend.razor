@* Leyenda bajo la vista semanal: de qué color salen las entradas online. *@
<div class="d-flex align-center gap-2 mt-2">
    <span class="calendar-legend-swatch" style="background-color: @Color"></span>
    <MudText Typo="Typo.body2">Entradas compradas en la web (pulsa el día para verlas en detalle)</MudText>
</div>

@code {
    [Parameter, EditorRequired] public string Color { get; set; } = "";
}
