<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">@Product.Name</MudText>
        <MudText Class="mb-4 mud-text-secondary">Precio: <b>@Product.SalePrice.ToString("C")</b></MudText>

        <MudStack Spacing="3">
            <MudNumericField T="decimal"
                             @bind-Value="amount"
                             Label="Porcentaje de descuento por entrada"
                             Min="0.01m"
                             Max="100.0m"
                             Format="N2"
                             AutoFocus="true"
                             Variant="Variant.Outlined" />

            <MudAlert Severity="@(IsValid ? Severity.Info : Severity.Error)" Dense="true">
                @if (IsValid)
                {
                    <text>La entrada costará <b>@((Product.SalePrice - (Product.SalePrice*amount/100)).ToString("C"))</b>.</text>
                }
                else
                {
                    <text>El porcentaje de descuento tiene que ser mayor que 0 y no más que 100.</text>
                }
            </MudAlert>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Large" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Size="Size.Large"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!IsValid)"
                   OnClick="Confirm">
            Aplicar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public Product Product { get; set; } = new();

    private decimal amount;

    private bool IsValid => amount > 0 && amount <= 100;

    private void Confirm()
    {
        if (!IsValid) return;
        Dialog.Close(DialogResult.Ok(SaleLineDiscount.Custom(amount)));
    }

    private void Cancel() => Dialog.Cancel();
}
