@* Apuntar una factura de proveedor. Si el proveedor no está en la lista, se crea desde aquí mismo
   sin perder lo que ya se ha escrito. Guarda él mismo: si falla (p. ej. factura repetida) se queda
   abierto, y al cerrarse devuelve la factura ya guardada. *@
@inject IProviderService ProviderService
@inject IInventoryService InventoryService
@inject IPurchaseInvoiceService PurchaseInvoiceService
@inject IDialogService Dialogs
@inject IFilePicker FilePicker
@inject ISnackbar Warnings

<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudStack Spacing="3">
                <div>
                    <div class="d-flex align-start gap-2">
                        <MudAutocomplete T="Provider" Value="provider" ValueChanged="SelectProvider"
                                         SearchFunc="SearchProviders" ToStringFunc="p => p?.LegalName"
                                         Label="Proveedor" Placeholder="Escribe el nombre o el NIF"
                                         Required="true" RequiredError="Elige el proveedor"
                                         ResetValueOnEmptyText="true" CoerceText="true" MaxItems="null"
                                         AdornmentIcon="@Icons.Material.Filled.Search" AutoFocus="true"
                                         Variant="Variant.Outlined" Class="flex-grow-1">
                            <ItemTemplate Context="p">
                                <div>
                                    <div class="product-name">@p.LegalName</div>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@p.Nif</MudText>
                                </div>
                            </ItemTemplate>
                            <NoItemsTemplate>
                                <MudText Class="pa-2">No hay ningún proveedor con ese nombre. Pulsa «Nuevo proveedor».</MudText>
                            </NoItemsTemplate>
                        </MudAutocomplete>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                   Class="mt-2" Style="white-space:nowrap; height:56px" OnClick="NewProvider">
                            Nuevo proveedor
                        </MudButton>
                    </div>

                    @* Datos del proveedor elegido, para comprobar que coinciden con los de la factura. *@
                    @if (provider is not null)
                    {
                        <MudPaper Outlined="true" Class="pa-3 mt-2">
                            <MudText Typo="Typo.body2"><b>NIF:</b> @provider.Nif</MudText>
                            @if (provider.Address is not null)
                            {
                                <MudText Typo="Typo.body2"><b>Dirección:</b> @provider.Address</MudText>
                            }
                            @if (provider.PhoneNumber is not null)
                            {
                                <MudText Typo="Typo.body2"><b>Teléfono:</b> @provider.PhoneNumber</MudText>
                            }
                            @if (provider.Email is not null)
                            {
                                <MudText Typo="Typo.body2"><b>Email:</b> @provider.Email</MudText>
                            }
                        </MudPaper>
                    }
                </div>

                <div class="d-flex gap-4">
                    <MudTextField T="string" @bind-Value="Invoice.Number" Label="Nº de factura" Required="true"
                                  RequiredError="Escribe el número de la factura"
                                  MaxLength="PurchaseInvoice.MaxNumberLength" Variant="Variant.Outlined" />
                    <MudDatePicker @bind-Date="invoiceDate" Label="Fecha de la factura" MaxDate="DateTime.Today"
                                   HelperText="La que pone la factura" Editable="true" Required="true"
                                   RequiredError="Elige la fecha de la factura" Variant="Variant.Outlined" />
                </div>

                @* Lo que viene en la factura: artículos del inventario (suman stock) o líneas libres. *@
                <div>
                    <MudText Typo="Typo.subtitle1" Class="mb-2">¿Qué viene en la factura?</MudText>
                    <div class="d-flex align-start flex-wrap gap-2">
                        <MudAutocomplete T="ShopProduct" @ref="productSearch" Value="null" ValueChanged="AddProduct"
                                         SearchFunc="SearchProducts" ToStringFunc="p => p?.Name"
                                         Label="Buscar artículo del inventario" Placeholder="Nombre o código de barras"
                                         ResetValueOnEmptyText="true" MaxItems="null" Clearable="true"
                                         AdornmentIcon="@Icons.Material.Filled.Search"
                                         Variant="Variant.Outlined" Class="flex-grow-1" Style="min-width:260px">
                            <ItemTemplate Context="p">
                                <div>
                                    <div class="product-name">@p.Name</div>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        Coste @p.CostPrice.ToString("C") · Hay @p.Stock @(p.BarCode is null ? "" : $"· {p.BarCode}")
                                    </MudText>
                                </div>
                            </ItemTemplate>
                            <NoItemsTemplate>
                                <MudText Class="pa-2">No hay ningún artículo de Tienda con ese nombre o código.</MudText>
                            </NoItemsTemplate>
                        </MudAutocomplete>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlaylistAdd"
                                   Class="mt-2" Style="white-space:nowrap; height:56px" OnClick="AddFreeLine">
                            Línea sin inventario
                        </MudButton>
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Los artículos del inventario suman sus unidades al stock y su precio pasa a ser el precio de coste.
                        Para lo que no es de la tienda (luz, una reparación...) usa «Línea sin inventario».
                    </MudText>

                    @if (Invoice.Lines.Count > 0)
                    {
                        <MudSimpleTable Dense="true" Outlined="true" Class="mt-3" Style="overflow-x:auto">
                            <thead>
                                <tr>
                                    <th>Concepto</th>
                                    <th style="width:110px">Cantidad</th>
                                    <th style="width:150px">Precio unidad (sin IVA)</th>
                                    <th style="width:120px">IVA</th>
                                    <th style="text-align:right; width:110px">Importe</th>
                                    <th style="width:48px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in Invoice.Lines)
                                {
                                    <tr @key="line">
                                        <td>
                                            @if (line.IsFree)
                                            {
                                                <MudTextField T="string" @bind-Value="line.Description" Placeholder="¿Qué es?"
                                                              Required="true" RequiredError="Escribe qué es"
                                                              MaxLength="PurchaseInvoiceLine.MaxDescriptionLength"
                                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            }
                                            else
                                            {
                                                <div class="product-name">@line.Description</div>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                    Suma al stock (hay @((line.Product as ShopProduct)?.Stock ?? 0))
                                                </MudText>
                                            }
                                        </td>
                                        <td>
                                            <MudNumericField T="int" @bind-Value="line.Quantity" Min="1" Max="PurchaseInvoiceLine.MaxQuantity"
                                                             Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                             Validation="@(new Func<int, string?>(q => q >= 1 ? null : "Mínimo 1"))" />
                                        </td>
                                        <td>
                                            <MudNumericField T="decimal" @bind-Value="line.UnitPrice" Min="0m" Format="N2"
                                                             Adornment="Adornment.End" AdornmentText="€" HideSpinButtons="true"
                                                             Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </td>
                                        <td>
                                            <MudSelect T="TaxRate" @bind-Value="line.TaxRate" ToStringFunc="t => t?.Name"
                                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                                @foreach (var rate in TaxRate.All)
                                                {
                                                    <MudSelectItem Value="rate">@(rate == TaxRate.TR000 ? "0% / exenta" : rate.Name)</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </td>
                                        <td style="text-align:right; white-space:nowrap">@line.BaseAmount.ToString("C")</td>
                                        <td>
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                                           OnClick="() => Invoice.Lines.Remove(line)" aria-label="Quitar línea" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>

                        @* Desglose como en la factura: base y cuota por tipo, y el total. *@
                        <MudPaper Outlined="true" Class="pa-3 mt-2">
                            @foreach (var item in Invoice.TaxBreakdown())
                            {
                                <MudText Typo="Typo.body2">
                                    Base al @item.TaxRate.Name: @item.BaseAmount.ToString("C") · IVA @item.TaxAmount.ToString("C")
                                </MudText>
                            }
                            <MudText Typo="Typo.h6" Class="mt-1">
                                Total: <b>@Invoice.TaxBreakdown().Sum(i => i.Total).ToString("C")</b>
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Comprueba que coincide con el total de la factura.</MudText>
                        </MudPaper>
                    }
                    else if (triedToSave)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2">
                            Añade lo que viene en la factura: busca los artículos o añade una línea sin inventario.
                        </MudText>
                    }
                </div>

                <div>
                    <MudText Typo="Typo.subtitle1" Class="mb-2">¿Está pagada?</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudButton Variant="@(paid ? Variant.Outlined : Variant.Filled)" Color="Color.Primary" FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.Schedule" OnClick="() => paid = false">
                                Pendiente de pago
                            </MudButton>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudButton Variant="@(paid ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="() => paid = true">
                                Ya está pagada
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                    @if (paid)
                    {
                        <div class="mt-3">
                            <PaymentFields @bind-Date="paymentDate" @bind-Method="paymentMethod" @bind-SalesPoint="paymentSalesPoint" ShowErrors="triedToSave" />
                        </div>
                    }
                </div>

                <div>
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Factura escaneada o foto</MudText>
                    @if (file is null)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AttachFile"
                                   OnClick="Attach">
                            Adjuntar factura
                        </MudButton>
                        @if (triedToSave)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2">Adjunta el archivo de la factura.</MudText>
                        }
                    }
                    else
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.AttachFile" Color="Color.Primary" Variant="Variant.Outlined"
                                 OnClose="() => file = null">
                            @file.FileName
                        </MudChip>
                    }
                </div>

                <MudTextField T="string" @bind-Value="Invoice.Notes" Label="Notas (opcional)" Lines="2"
                              MaxLength="PurchaseInvoice.MaxNotesLength" Variant="Variant.Outlined" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Large" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" Disabled="saving" OnClick="Save">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public PurchaseInvoice Invoice { get; set; } = new();

    private List<Provider> providers = [];
    private List<ShopProduct> products = [];
    private MudAutocomplete<ShopProduct> productSearch = default!;
    private Provider? provider;
    private InvoiceFile? file;
    private bool triedToSave;
    private bool saving;
    private MudForm form = default!;

    private DateTime? invoiceDate = DateTime.Today;
    // Por defecto pendiente: lo normal es apuntarla al recibirla y pagarla después.
    private bool paid;
    private DateTime? paymentDate = DateTime.Today;
    private PaymentMethod? paymentMethod;
    private SalesPoint? paymentSalesPoint;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            providers = await ProviderService.GetProvidersAsync();
            products = (await InventoryService.GetProductsAsync(SalesPoint.Shop)).OfType<ShopProduct>().ToList();
        }
        catch (Exception)
        {
            Warnings.Add("No se han podido cargar los proveedores o los artículos. Inténtalo de nuevo.", Severity.Error);
        }
    }

    // Sin distinguir mayúsculas ni tildes; el NIF se busca sin espacios ni guiones.
    private Task<IEnumerable<Provider>> SearchProviders(string? text, CancellationToken _)
    {
        if (string.IsNullOrWhiteSpace(text)) return Task.FromResult<IEnumerable<Provider>>(providers);

        var search = text.Trim();
        var nif = TaxId.Normalize(search);
        return Task.FromResult(providers.Where(p =>
            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.LegalName, search, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0
            || (nif.Length > 0 && p.Nif.Contains(nif))));
    }

    // Por nombre (sin distinguir mayúsculas ni tildes) o por código de barras, que es lo que teclea el lector.
    private Task<IEnumerable<ShopProduct>> SearchProducts(string? text, CancellationToken _)
    {
        if (string.IsNullOrWhiteSpace(text)) return Task.FromResult<IEnumerable<ShopProduct>>(products);

        var search = text.Trim();
        return Task.FromResult(products.Where(p =>
            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Name, search, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0
            || p.BarCode == search));
    }

    // Si el artículo ya está en la factura, se suma una unidad en vez de repetir la línea.
    private async Task AddProduct(ShopProduct? product)
    {
        if (product is null) return;

        var existing = Invoice.Lines.FirstOrDefault(l => l.ProductId == product.Id);
        if (existing is not null)
            existing.Quantity++;
        else
            Invoice.Lines.Add(PurchaseInvoiceLine.For(product));

        await productSearch.ClearAsync();
    }

    private void AddFreeLine() => Invoice.Lines.Add(new PurchaseInvoiceLine());

    private void SelectProvider(Provider? selected)
    {
        provider = selected;
        Invoice.ProviderId = selected?.Id ?? 0;
    }

    private async Task NewProvider()
    {
        var parameters = new DialogParameters<ProviderDialog> { { x => x.Provider, new Provider() } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await Dialogs.ShowAsync<ProviderDialog>("Nuevo proveedor", parameters, options);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: Provider saved }) return;

        // Ya está guardado: se añade a la lista y se deja elegido (el buscador muestra su nombre).
        providers = providers.Append(saved).OrderBy(p => p.LegalName).ToList();
        SelectProvider(saved);
    }

    private async Task Attach()
    {
        try
        {
            file = await InvoiceUploads.PickAsync(FilePicker) ?? file;
        }
        catch (BusinessRuleException ex)
        {
            Warnings.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Warnings.Add("No se ha podido leer el archivo. Inténtalo de nuevo.", Severity.Error);
        }
    }

    private async Task Save()
    {
        triedToSave = true;
        await form.ValidateAsync();
        if (!form.IsValid || provider is null || file is null || invoiceDate is null) return;
        if (paid && (paymentDate is null || paymentMethod is null)) return;

        Invoice.InvoiceDate = invoiceDate.Value;
        Invoice.PaymentDate = paid ? paymentDate : null;
        Invoice.PaymentMethod = paid ? paymentMethod : null;
        Invoice.PaymentSalesPoint = paid ? paymentSalesPoint : null;

        saving = true;
        try
        {
            var saved = await PurchaseInvoiceService.RegisterInvoiceAsync(Invoice, file);
            Dialog.Close(DialogResult.Ok(saved));
        }
        catch (BusinessRuleException ex)
        {
            Warnings.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Warnings.Add("No se ha podido guardar la factura. Inténtalo de nuevo.", Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
