<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudStack Spacing="3">
                <div class="d-flex gap-3">
                    @foreach (var category in ProductCategory.All)
                    {
                        <MudButton Variant="@(product.Category == category ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary" Size="Size.Large" FullWidth="true"
                                   StartIcon="@ActiveProfile.Icon(category.SalesPoint)"
                                   Disabled="@(!IsNew && product.Category != category)" OnClick="() => ChangeCategory(category)">
                            @category.Name
                        </MudButton>
                    }
                </div>
                @if (!IsNew)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        El tipo no se puede cambiar. Si te has equivocado, da de baja el producto y crea uno nuevo.
                    </MudText>
                }

                <MudTextField T="string" @bind-Value="product.Name" Label="Nombre" Required="true"
                              RequiredError="Escribe el nombre del producto" AutoFocus="true" Variant="Variant.Outlined" />

                @switch (product)
                {
                    case TicketProduct ticket:
                        <MudNumericField T="decimal" @bind-Value="ticket.SalePrice" Label="Precio de venta" Min="0m" Format="N2"
                                         Adornment="Adornment.End" AdornmentText="€" Variant="Variant.Outlined" />

                        <MudNumericField T="int" @bind-Value="ticket.CountsAs" Label="Cuenta como"
                                         HelperText="Entradas que suma al recuento cada vez que se vende. Por ejemplo, un cupón de 2 entradas cuenta como 2"
                                         Min="1" Variant="Variant.Outlined" />
                        break;

                    case ShopProduct shop:
                        <MudTextField T="string" @bind-Value="shop.BarCode" Label="Código de barras (opcional)"
                                      HelperText="Puedes escanearlo con el lector" Variant="Variant.Outlined" />

                        <div class="d-flex gap-4">
                            <MudNumericField T="decimal" @bind-Value="shop.SalePrice" Label="Precio de venta" Min="0m"
                                             Format="N2" Adornment="Adornment.End" AdornmentText="€" Variant="Variant.Outlined" />
                            <MudNumericField T="decimal" @bind-Value="shop.CostPrice" Label="Precio de coste"
                                             HelperText="Lo que le cuesta al museo" Min="0m" Format="N2" Adornment="Adornment.End"
                                             AdornmentText="€" Variant="Variant.Outlined" />
                        </div>

                        <div class="d-flex gap-4">
                            @if (IsNew)
                            {
                                <MudNumericField T="int" @bind-Value="shop.Stock" Label="Unidades iniciales" Min="0"
                                                 Variant="Variant.Outlined" />
                            }
                            <MudNumericField T="int" @bind-Value="shop.MinStock" Label="Avisar cuando queden"
                                             HelperText="Se marcará como stock bajo" Min="0" Variant="Variant.Outlined" />
                        </div>
                        break;
                }
                <MudSwitch T="bool" Value="hasTaxExemption" ValueChanged="ChangeHasTaxExemption" Color="Color.Primary"
                           Class="mt-4">
                    Exento de impuestos
                </MudSwitch>
                
                @if (!hasTaxExemption)
                {
                    <MudSelect T="TaxRate" Value="product.TaxRate" ValueChanged="ChangeTaxRate" Label="IVA"
                               ToStringFunc="t => t?.Name" Variant="Variant.Outlined" Required="true"
                               RequiredError="Elige el IVA aplicable">
                        @foreach (var taxRate in TaxRate.All)
                        {
                            <MudSelectItem Value="taxRate">@taxRate.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudSelect T="TaxExemption" Value="product.TaxExemption" ValueChanged="ChangeTaxExemption"
                               Label="Tipo de exención" ToStringFunc="t => t?.Description" Variant="Variant.Outlined"
                               Required="true" RequiredError="Elige la exención aplicada">
                        @foreach (var taxExemption in TaxExemption.All)
                        {
                            <MudSelectItem Value="taxExemption">@taxExemption.Value - @taxExemption.Description</MudSelectItem>
                        }
                    </MudSelect>
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Large" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired] public Product Product { get; set; } = default!;

    private Product product = default!;
    private MudForm form = default!;

    private bool IsNew => product.Id == 0;
    private bool hasTaxExemption { get; set; }

    protected override void OnInitialized()
    {
        product = Product;
        hasTaxExemption = Product.TaxExemption is not null;
    }

    private readonly Dictionary<ProductCategory, Product> drafts = [];

    private void ChangeCategory(ProductCategory category)
    {
        if (!IsNew || category == product.Category) return;

        drafts[product.Category] = product;
        var next = drafts.GetValueOrDefault(category) ?? Product.New(category);
        next.Name = product.Name;
        next.SalePrice = product.SalePrice;
        next.TaxRate = product.TaxRate;
        next.TaxExemption = product.TaxExemption;
        product = next;
    }

    private void ChangeTaxRate(TaxRate taxRate)
    {
        product.TaxRate = taxRate;
        product.TaxExemption = null;
    }
    
    private void ChangeTaxExemption(TaxExemption taxExemption)
    {
        product.TaxExemption = taxExemption;
        product.TaxRate = null;
    }

    private void ChangeHasTaxExemption(bool value)
    {
        hasTaxExemption = value;
        product.TaxRate = null;
        product.TaxExemption = null;
    }

    private async Task Save()
    {
        await form.ValidateAsync();
        if (!form.IsValid) return;
        Dialog.Close(DialogResult.Ok(product));
    }

    private void Cancel() => Dialog.Cancel();
}
