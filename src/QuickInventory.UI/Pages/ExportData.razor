@page "/export"
@inject ISalesService SalesService
@inject IRefundService RefundService
@inject IFileSaver FileSaver
@inject ISnackbar Warnings

<h1 class="page-title">Exportar ventas</h1>

<div class="d-flex align-center flex-wrap gap-4 mb-4">
    @* Selector de mes: flechas grandes en vez de un calendario. *@
    <div class="d-flex align-center gap-2">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Variant="Variant.Outlined" Size="Size.Large"
                       OnClick="() => ChangeMonth(-1)" aria-label="Mes anterior" />
        <MudText Typo="Typo.h6" Class="export-month">@month.ToString("MMMM 'de' yyyy")</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Variant="Variant.Outlined" Size="Size.Large"
                       OnClick="() => ChangeMonth(1)" Disabled="@IsCurrentMonth" aria-label="Mes siguiente" />
    </div>

    <MudTextField T="string"
                  @bind-Value="searching"
                  Placeholder="Buscar por número, producto, método de pago o punto de venta"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Variant="Variant.Outlined"
                  Immediate="true"
                  Clearable="true"
                  Class="finder" />
</div>

@if (sales is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @* Al cargar el mes se marcan todas las ventas menos las anuladas. Quitar la marca deja la fila fuera del archivo. *@
    <MudTable T="Sale" Items="Filtered" MultiSelection="true" @bind-SelectedItems="selected" SelectOnRowClick="true"
              Hover="true" Striped="true" Dense="true" Elevation="1" RowsPerPage="50" Breakpoint="Breakpoint.Sm"
              RowStyle="cursor:pointer"
              RowClassFunc="@((sale, _) => sale.Canceled ? "sale-canceled-row" : "")">
        <HeaderContent>
            <MudTh><MudTableSortLabel T="Sale" SortBy="s => s.Id">ID</MudTableSortLabel></MudTh>
            <MudTh>
                <MudTableSortLabel T="Sale" SortBy="s => s.Date" InitialDirection="SortDirection.Ascending">Fecha</MudTableSortLabel>
            </MudTh>
            <MudTh><MudTableSortLabel T="Sale" SortBy="s => s.SalesPoint">Punto de venta</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="Sale" SortBy="s => s.PaymentMethod">Pago</MudTableSortLabel></MudTh>
            <MudTh>Productos</MudTh>
            <MudTh Style="text-align:right">
                <MudTableSortLabel T="Sale" SortBy="s => s.Total">Total</MudTableSortLabel>
            </MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="ID"><span class="product-name">@context.Id</span></MudTd>
            <MudTd DataLabel="Fecha" Style="white-space:nowrap">@context.Date.ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Punto de venta">@ActiveProfile.Name(context.SalesPoint)</MudTd>
            <MudTd DataLabel="Pago">@PaymentMethods.Name(context.PaymentMethod)</MudTd>
            <MudTd DataLabel="Productos">
                @SalesExport.Products(context)
                @if (context.Canceled)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="ml-2">Anulada</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Total" Style="text-align:right;white-space:nowrap">@context.Total.ToString("C")</MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">
                @(sales.Count == 0 ? "No hay ventas en este mes." : "Ninguna venta coincide con la búsqueda.")
            </MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página:"
                           InfoFormat="{first_item}-{last_item} de {all_items}" />
        </PagerContent>
    </MudTable>

    <MudPaper Class="pa-4 mt-4 d-flex align-center flex-wrap gap-4" Outlined="true">
        <div class="flex-grow-1">
            <MudText Typo="Typo.h6">@ToExport.Count de @Filtered.Count() ventas seleccionadas</MudText>
            <MudText Typo="Typo.body2">
                Total sin anuladas: <b>@ToExport.Where(s => !s.Canceled).Sum(s => s.Total).ToString("C")</b>
            </MudText>
            @* Los reembolsos no se eligen uno a uno: van todos los del mes en su propia hoja del Excel. *@
            <MudText Typo="Typo.body2">
                Reembolsos del mes (solo en Excel): @ValidRefunds.Count() ·
                <b>@ValidRefunds.Sum(r => r.Amount).ToString("C")</b>
                · @refunds.Count(r => r.InvoiceFileName is not null) con factura adjunta
            </MudText>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Description" Disabled="@(ToExport.Count == 0 || saving)"
                   OnClick="ExportCsv">
            Exportar CSV
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.TableView" Disabled="@((ToExport.Count == 0 && refunds.Count == 0) || saving)"
                   OnClick="ExportExcel">
            Exportar Excel
        </MudButton>
        @* Un ZIP con el Excel y una carpeta con las facturas; en el Excel cada factura es un enlace. *@
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.FolderZip" Disabled="@((ToExport.Count == 0 && refunds.Count == 0) || saving)"
                   OnClick="ExportExcelWithInvoices">
            Exportar Excel con facturas
        </MudButton>
    </MudPaper>
}

@code {
    /// <summary>Primer día del mes que se está viendo.</summary>
    private DateTime month = new(DateTime.Today.Year, DateTime.Today.Month, 1);

    private List<Sale>? sales;
    private List<CashMovement> refunds = [];
    private HashSet<Sale> selected = [];
    private string? searching;
    private bool saving;

    private IEnumerable<CashMovement> ValidRefunds => refunds.Where(r => !r.Canceled);

    private bool IsCurrentMonth => month.AddMonths(1) > DateTime.Today;

    private IEnumerable<Sale> Filtered =>
        string.IsNullOrWhiteSpace(searching)
            ? sales ?? []
            : (sales ?? []).Where(s => Matches(s, searching.Trim()));

    /// <summary>
    /// Ventas que irán al archivo: las marcadas que se ven con la búsqueda actual,
    /// para que lo exportado sea siempre lo que hay en pantalla.
    /// </summary>
    private List<Sale> ToExport => Filtered.Where(selected.Contains).OrderBy(s => s.Date).ToList();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task ChangeMonth(int months)
    {
        month = month.AddMonths(months);
        await Load();
    }

    private async Task Load()
    {
        sales = null;
        sales = await SalesService.GetSalesAsync(month, month.AddMonths(1));
        refunds = await RefundService.GetRefundsAsync(month, month.AddMonths(1));
        selected = sales.Where(s => !s.Canceled).ToHashSet();
    }

    private static bool Matches(Sale sale, string text) =>
        Contains(sale.Id.ToString(), text)
        || Contains(SalesExport.Products(sale), text)
        || Contains(PaymentMethods.Name(sale.PaymentMethod), text)
        || Contains(ActiveProfile.Name(sale.SalesPoint), text)
        || Contains(sale.Date.ToString("dd/MM/yyyy"), text);

    private static bool Contains(string origin, string text) =>
        CultureInfo.CurrentCulture.CompareInfo.IndexOf(
            origin, text, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0;

    private Task ExportCsv() => Export(SalesExport.ToCsv(ToExport), "csv");

    private Task ExportExcel() => Export(SalesExport.ToExcel(ToExport, refunds), "xlsx");

    private Task ExportExcelWithInvoices() => Export(async () =>
    {
        var withInvoice = refunds.Where(r => r.InvoiceFileName is not null).Select(r => r.Id).ToList();
        var invoices = await RefundService.GetInvoicesAsync(withInvoice);
        return SalesExport.ToZipWithInvoices(ToExport, refunds, invoices, $"{FileName}.xlsx");
    }, "zip");

    /// <summary>Nombre de los archivos exportados, sin extensión.</summary>
    private string FileName => $"Ventas {month:yyyy-MM}";

    private Task Export(byte[] content, string extension) => Export(() => Task.FromResult(content), extension);

    private async Task Export(Func<Task<byte[]>> content, string extension)
    {
        saving = true;
        try
        {
            var name = $"{FileName}.{extension}";
            if (await FileSaver.SaveAsync(name, await content()))
                Warnings.Add($"Archivo guardado: {name}", Severity.Success);
        }
        catch (IOException)
        {
            Warnings.Add("No se ha podido guardar el archivo. Si lo tienes abierto en Excel, ciérralo e inténtalo de nuevo.", Severity.Warning);
        }
        catch (Exception)
        {
            Warnings.Add("No se ha podido guardar el archivo. Inténtalo de nuevo.", Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }
}
