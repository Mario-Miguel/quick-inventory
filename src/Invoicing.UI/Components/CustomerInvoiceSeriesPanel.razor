@* Series de las facturas a clientes: tabla, «Nueva serie de facturas» y edición. Va dentro de una pantalla de
   la aplicación (p. ej. junto a sus series de tickets). *@
@inject ICustomerInvoiceSeriesService SeriesService
@inject IDialogService Dialogs
@inject ISnackbar Warnings

<div class="d-flex align-center flex-wrap gap-4 mb-2">
    <MudText Typo="Typo.h6">@Title</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Add"
               OnClick="NewSeries">
        Nueva serie de facturas
    </MudButton>
</div>

@if (series is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (MissingThisYear)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
            Falta la serie de facturas a clientes de @DateTime.Now.Year. Hace falta para emitir facturas a colegios u organizaciones.
        </MudAlert>
    }

    <MudTable T="CustomerInvoiceSeriesStatus" Items="series" Hover="true" Striped="true" Elevation="1" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Año</MudTh>
            <MudTh>Código</MudTh>
            <MudTh Style="text-align:right">Último número</MudTh>
            <MudTh>Próxima factura</MudTh>
            <MudTh Style="text-align:right">Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Año">@context.Series.Year</MudTd>
            <MudTd DataLabel="Código"><b>@context.Series.Code</b></MudTd>
            <MudTd DataLabel="Último número" Style="text-align:right">@context.Series.LastNumber</MudTd>
            <MudTd DataLabel="Próxima factura">@context.Series.NextInvoiceId</MudTd>
            <MudTd Style="text-align:right; white-space:nowrap">
                @if (context.InUse)
                {
                    <MudTooltip Text="Ya tiene facturas emitidas: no se puede cambiar">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Default" Class="mx-3" />
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="() => Edit(context.Series)" aria-label="Editar" />
                    </MudTooltip>
                }
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">Todavía no hay ninguna serie de facturas a clientes.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    [Parameter] public string Title { get; set; } = "Facturas a clientes";

    private List<CustomerInvoiceSeriesStatus>? series;

    private static readonly DialogOptions DialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
    };

    private bool MissingThisYear => series?.Any(s => s.Series.Year == DateTime.Now.Year) == false;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try
        {
            series = await SeriesService.GetSeriesAsync();
        }
        catch (Exception)
        {
            Warnings.Add("No se han podido cargar las series de facturas. Inténtalo de nuevo.", Severity.Error);
        }
    }

    // Propone la de este año si falta; si no, la del siguiente.
    private Task NewSeries()
    {
        var year = MissingThisYear ? DateTime.Now.Year : DateTime.Now.Year + 1;
        var newSeries = new CustomerInvoiceSeries
        {
            Year = year,
            Code = CustomerInvoiceSeries.SuggestedCode(year),
        };
        return OpenEditor(newSeries, "Nueva serie de facturas a clientes");
    }

    // Se edita una copia: si el usuario cancela, la tabla no cambia.
    private Task Edit(CustomerInvoiceSeries s) => OpenEditor(s.Clone(), "Editar serie de facturas a clientes");

    private async Task OpenEditor(CustomerInvoiceSeries editing, string title)
    {
        var parameters = new DialogParameters<NumberingSeriesDialog>
        {
            { x => x.Series, editing },
            { x => x.SuggestCode, CustomerInvoiceSeries.SuggestedCode },
            { x => x.Texts, NumberingSeriesTexts.CustomerInvoices },
        };
        var dialog = await Dialogs.ShowAsync<NumberingSeriesDialog>(title, parameters, DialogOptions);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: CustomerInvoiceSeries saved }) return;

        try
        {
            await SeriesService.SaveSeriesAsync(saved);
            Warnings.Add($"Serie {saved.Code} guardada.", Severity.Success);
        }
        catch (BusinessRuleException ex)
        {
            Warnings.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Warnings.Add("No se ha podido guardar el cambio. Inténtalo de nuevo.", Severity.Error);
        }

        await Load();
    }
}
