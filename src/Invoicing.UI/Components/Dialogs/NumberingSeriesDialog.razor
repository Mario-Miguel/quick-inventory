@* Crea o edita una serie de numeración (de facturas a clientes o de otros documentos de la aplicación,
   como los tickets). Los textos cambian según el documento (Texts). *@
<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudStack Spacing="3">
                @if (Texts.Intro is not null)
                {
                    <MudText Class="mud-text-secondary">@Texts.Intro</MudText>
                }

                <MudNumericField T="int" Value="series.Year" ValueChanged="ChangeYear" Label="Año"
                                 Min="2000" Max="@(DateTime.Now.Year + 1)" Variant="Variant.Outlined" />

                <MudTextField T="string" @bind-Value="series.Code" Label="Código de la serie" Required="true"
                              RequiredError="Escribe el código de la serie" MaxLength="NumberingSeries.MaxCodeLength"
                              HelperText="@Texts.CodeHelper"
                              Immediate="true" Variant="Variant.Outlined" />

                <MudNumericField T="int" @bind-Value="series.LastNumber" Label="@Texts.LastNumberLabel"
                                 HelperText="@Texts.LastNumberHelper"
                                 Min="0" Immediate="true" Variant="Variant.Outlined" />

                <MudAlert Severity="Severity.Info" Dense="true">
                    @Texts.NextPrefix <b>@Preview</b>.
                </MudAlert>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Large" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired] public NumberingSeries Series { get; set; } = default!;

    /// <summary>Código propuesto para un año (p. ej. <see cref="CustomerInvoiceSeries.SuggestedCode"/>).</summary>
    [Parameter, EditorRequired] public Func<int, string> SuggestCode { get; set; } = default!;

    [Parameter] public NumberingSeriesTexts Texts { get; set; } = NumberingSeriesTexts.CustomerInvoices;

    private NumberingSeries series = default!;
    private MudForm form = default!;

    private string Preview => NumberingSeries.FormatInvoiceId(series.Code.Trim().ToUpperInvariant(), series.LastNumber + 1);

    protected override void OnInitialized() => series = Series;

    // Si el código es el propuesto, cambia con el año; si lo han escrito a mano, se respeta.
    private void ChangeYear(int year)
    {
        var suggested = series.Code == SuggestCode(series.Year);
        series.Year = year;
        if (suggested) series.Code = SuggestCode(series.Year);
    }

    private async Task Save()
    {
        await form.ValidateAsync();
        if (!form.IsValid) return;
        Dialog.Close(DialogResult.Ok(series));
    }

    private void Cancel() => Dialog.Cancel();
}
