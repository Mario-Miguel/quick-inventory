@* Emitir una factura a un cliente (colegio, asociación...). El número lo pone el servicio con la serie
   del año, y los datos del museo salen del titular. Como una factura emitida no se puede cambiar ni
   borrar, pide confirmación antes. Al cerrarse devuelve la factura ya emitida, con su número. *@
@inject ICustomerInvoiceService CustomerInvoiceService
@inject IDialogService Dialogs
@inject ISnackbar Warnings

<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudStack Spacing="3">
                <CustomerPicker Customer="customer" CustomerChanged="SelectCustomer" />

                <MudDatePicker @bind-Date="invoiceDate" Label="Fecha de la factura" MaxDate="DateTime.Today"
                               HelperText="El número se pone solo al emitirla" Editable="true" Required="true"
                               RequiredError="Elige la fecha de la factura" Variant="Variant.Outlined" Style="max-width:280px" />

                <div>
                    <MudText Typo="Typo.subtitle1" Class="mb-2">¿Qué se factura?</MudText>
                    <MudSimpleTable Dense="true" Outlined="true" Style="overflow-x:auto">
                        <thead>
                            <tr>
                                <th>Concepto</th>
                                <th style="width:110px">Cantidad</th>
                                <th style="width:150px">Precio unidad (sin IVA)</th>
                                <th style="width:200px">IVA</th>
                                <th style="text-align:right; width:110px">Importe</th>
                                <th style="width:48px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Invoice.Lines)
                            {
                                <tr @key="line">
                                    <td>
                                        <MudTextField T="string" @bind-Value="line.Description" Placeholder="Por ejemplo, «Entrada escolar»"
                                                      Required="true" RequiredError="Escribe el concepto" Immediate="true"
                                                      MaxLength="CustomerInvoiceLine.MaxDescriptionLength"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </td>
                                    <td>
                                        <MudNumericField T="int" @bind-Value="line.Quantity" Min="1" Max="CustomerInvoiceLine.MaxQuantity"
                                                         Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                         Validation="@(new Func<int, string?>(q => q >= 1 ? null : "Mínimo 1"))" />
                                    </td>
                                    <td>
                                        <MudNumericField T="decimal" @bind-Value="line.UnitPrice" Min="0m" Format="N2"
                                                         Adornment="Adornment.End" AdornmentText="€" HideSpinButtons="true"
                                                         Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </td>
                                    <td>
                                        <MudSelect T="TaxOption" Value="TaxOption.Of(line)" ValueChanged="o => o.ApplyTo(line)"
                                                   ToStringFunc="o => o?.Name" Variant="Variant.Outlined" Margin="Margin.Dense">
                                            @foreach (var option in TaxOption.All)
                                            {
                                                <MudSelectItem Value="option">@option.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </td>
                                    <td style="text-align:right; white-space:nowrap">@line.BaseAmount.ToString("C")</td>
                                    <td>
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                                       OnClick="() => Invoice.Lines.Remove(line)" aria-label="Quitar línea" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlaylistAdd"
                               Class="mt-2" OnClick="AddLine">
                        Añadir concepto
                    </MudButton>

                    @if (Invoice.Lines.Count > 0)
                    {
                        <MudPaper Outlined="true" Class="pa-3 mt-2">
                            @foreach (var item in Invoice.TaxBreakdown())
                            {
                                <MudText Typo="Typo.body2">
                                    @(item.TaxRate is null ? item.Name : $"Base al {item.Name}"): @item.TaxBase?.ToString("C") · IVA @item.TaxAmount?.ToString("C")
                                </MudText>
                            }
                            <MudText Typo="Typo.h6" Class="mt-1">
                                Total: <b>@Invoice.TaxBreakdown().Sum(i => i.Total).ToString("C")</b>
                            </MudText>
                        </MudPaper>
                    }
                </div>

                <MudTextField T="string" @bind-Value="Invoice.Notes" Label="Observaciones (opcional)" Lines="2"
                              HelperText="Salen en la factura. Por ejemplo, «Visita del 12/11/2026, 45 alumnos de 3.º de ESO»"
                              MaxLength="CustomerInvoice.MaxNotesLength" Variant="Variant.Outlined" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        @* Con el botón desactivado se dice qué falta, para que no parezca que no funciona. *@
        @if (Missing is { } missing)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mr-auto ml-4">Falta: @missing.</MudText>
        }
        <MudButton Size="Size.Large" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(saving || Missing is not null)" OnClick="Save">
            Emitir factura
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public CustomerInvoice Invoice { get; set; } = new();

    private Customer? customer;
    private DateTime? invoiceDate = DateTime.Today;
    private bool saving;
    private MudForm form = default!;

    // Se empieza con una línea vacía: siempre hace falta al menos una.
    protected override void OnInitialized()
    {
        if (Invoice.Lines.Count == 0) AddLine();
    }

    /// <summary>Lo que falta para poder emitirla, o null si está todo. Mientras falte algo, el botón está desactivado.</summary>
    private string? Missing
    {
        get
        {
            List<string> missing = [];
            if (customer is null) missing.Add("el cliente");
            else if (customer.Address is null) missing.Add("la dirección del cliente");
            if (invoiceDate is null) missing.Add("la fecha");
            if (Invoice.Lines.Count == 0 || Invoice.Lines.Any(l => string.IsNullOrWhiteSpace(l.Description)))
                missing.Add("el concepto");
            else if (Invoice.TaxBreakdown().Sum(i => i.Total) <= 0) missing.Add("el precio");

            return missing.Count switch
            {
                0 => null,
                1 => missing[0],
                _ => string.Join(", ", missing[..^1]) + " y " + missing[^1],
            };
        }
    }

    private void AddLine() => Invoice.Lines.Add(new CustomerInvoiceLine());

    private void SelectCustomer(Customer? selected)
    {
        customer = selected;
        Invoice.CustomerId = selected?.Id ?? 0;
    }

    private async Task Save()
    {
        await form.ValidateAsync();
        if (!form.IsValid || customer is null || invoiceDate is null) return;

        Invoice.InvoiceDate = invoiceDate.Value;
        var total = Invoice.TaxBreakdown().Sum(i => i.Total);

        // Una factura emitida no se puede cambiar ni borrar: mejor confirmarlo.
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Emitir factura",
            $"¿Emitir la factura a {customer.LegalName} por {total:C}? Una vez emitida no se puede cambiar ni borrar.",
            yesText: "Emitir",
            cancelText: "Revisar");
        if (confirmed != true) return;

        saving = true;
        try
        {
            var saved = await CustomerInvoiceService.IssueInvoiceAsync(Invoice);
            Dialog.Close(DialogResult.Ok(saved));
        }
        catch (BusinessRuleException ex)
        {
            Warnings.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Warnings.Add("No se ha podido emitir la factura. Inténtalo de nuevo.", Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private void Cancel() => Dialog.Cancel();

    /// <summary>
    /// Opción del desplegable de IVA: un tipo (21 %, 10 %, 4 %) o una causa de exención. El 0 % sin causa
    /// no se ofrece: en una factura, si no lleva IVA hay que decir por qué está exenta.
    /// </summary>
    private sealed record TaxOption(string Name, TaxRate? Rate, TaxExemption? Exemption)
    {
        public static readonly IReadOnlyList<TaxOption> All =
        [
            .. TaxRate.All.Where(r => r != TaxRate.TR000).Select(r => new TaxOption(r.Name, r, null)),
            .. TaxExemption.All.Select(e => new TaxOption(e.Description, null, e)),
        ];

        public static TaxOption? Of(CustomerInvoiceLine line) =>
            All.FirstOrDefault(o => o.Rate == line.TaxRate && o.Exemption == line.TaxExemption);

        public void ApplyTo(CustomerInvoiceLine line)
        {
            line.TaxRate = Rate;
            line.TaxExemption = Exemption;
        }
    }
}
