<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Pantallas de facturas a clientes (Blazor + MudBlazor): clientes, facturas, diseño y series.
       La aplicación anfitriona las añade a su Router (AdditionalAssemblies) y registra los servicios
       de Invoicing y las interfaces de este proyecto. Ver ../Invoicing/README.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Invoicing.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.*" />
    <PackageReference Include="MudBlazor" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Invoicing\Invoicing.csproj" />
  </ItemGroup>

</Project>
