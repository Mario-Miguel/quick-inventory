<Project Sdk="Microsoft.NET.Sdk">

  <!-- Persistencia de Invoicing con Entity Framework Core. No elige base de datos: la pone la aplicación
       anfitriona con su DbContext (que implementa IInvoicingDbContext). Ver ../Invoicing/README.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Invoicing.EntityFrameworkCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Invoicing\Invoicing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Invoicing.Models" />
    <Using Include="Invoicing.Services" />
    <Using Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

</Project>
